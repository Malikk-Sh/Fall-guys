[Unit]
Description=Verify latest Wobble Rush backup integrity
Documentation=https://github.com/Malikk-Sh/Fall-guys
After=local-fs.target

[Service]
Type=oneshot
User=wobble
Group=wobble
WorkingDirectory=/opt/wobble
StateDirectory=wobble
EnvironmentFile=/etc/wobble.env
ExecStart=/usr/bin/node /opt/wobble/server/verifyLatestBackup.mjs
TimeoutStartSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
