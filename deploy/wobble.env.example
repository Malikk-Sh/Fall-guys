# Настройки сервера. Копировать в /etc/wobble.env и отредактировать.
#
# chmod 600 /etc/wobble.env — файл читает только root и systemd.

NODE_ENV=production

# Порт, на котором слушает Node. Наружу он не смотрит — снаружи стоит Nginx.
PORT=3000

# Слушать только локальный интерфейс.
#
# Без этого порт 3000 виден из интернета напрямую, в обход Nginx: без TLS, без заголовков
# безопасности и без ограничений по адресу. Игра при этом работает, поэтому ошибку легко
# не заметить.
HOST=127.0.0.1

# Разбирать X-Forwarded-For.
#
# За Nginx адрес соединения — это всегда 127.0.0.1, один на всех. Ограничения «24 сокета и
# 40 операций с комнатами в минуту с адреса» тогда делятся между ВСЕМИ игроками сразу, и отказы
# начинают сыпаться на случайных людей при нескольких десятках человек онлайн.
#
# Включать ТОЛЬКО когда Node недоступен из интернета напрямую (см. HOST выше): иначе заголовок
# подделает кто угодно и обойдёт лимиты.
TRUST_PROXY=1

# Кто может открывать WebSocket. Через запятую, со схемой, без слэша на конце.
# Если не задать — разрешены свой хост и localhost. Задать стоит: это защита от того, что игру
# встроят на чужой сайт и будут гонять ваш сервер оттуда.
#
# ПОРТ ВХОДИТ В ЗНАЧЕНИЕ, если он нестандартный. Браузер пришлёт Origin вида
# https://example.com:8443, и без порта сервер не признает его своим — игра откроется,
# а напарник не подключится.
ALLOWED_ORIGINS=https://example.com
# Глобальные пределы одного процесса. Подбирайте по памяти и результатам load-test.
MAX_ROOMS=500
MAX_ACTIVE_SOCKETS=2000
MAX_ACTIVE_MATCHES=300
# При устойчивой задержке event loop сервер перестаёт брать новые комнаты и снижает snapshots до 10 Гц.
# Задержка считается 95-м перцентилем за последние пять секунд, а не за всё время работы процесса:
# иначе показатель тем меньше реагирует, чем дольше сервер работает.
MAX_EVENT_LOOP_LAG_MS=120

# Файл с таблицей подтверждённых рекордов (SQLite).
#
# Каталог создаёт systemd по StateDirectory=wobble в юните, владельцем назначается служба.
# Путь намеренно вне /opt/wobble: тот каталог обновляется через git, и данные игроков не должны
# зависеть от того, что там делает установщик.
#
# Если не задать — таблица живёт в памяти и исчезает при каждом перезапуске. Сервер при этом
# работает, поэтому пропущенную настройку легко не заметить: проверить можно тем, что рекорд,
# поставленный до `systemctl restart wobble`, остаётся на месте после него.
LEADERBOARD_DB=/var/lib/wobble/leaderboard.db

# Production backups ---------------------------------------------------------------
# Hourly local snapshots: 48 hourly / 7 daily / 4 weekly / 3 monthly.
BACKUP_DIR=/var/lib/wobble/backups
BACKUP_STATUS_FILE=/var/lib/wobble/backups/status.json
BACKUP_MAX_AGE_SECONDS=7200

# Off-server storage must be physically outside this VPS and mounted here.
# While the remote mount is active, create its sentinel once: touch /mnt/wobble-offsite/.wobble-offsite
BACKUP_OFFSITE_DIR=
BACKUP_OFFSITE_SENTINEL=.wobble-offsite
BACKUP_OFFSITE_EVERY_SECONDS=86400
BACKUP_OFFSITE_KEEP=30
BACKUP_OFFSITE_MAX_AGE_SECONDS=129600
# Set to 1 after off-server storage is commissioned.
BACKUP_REQUIRE_OFFSITE=0

# Optional generic JSON webhook for stale-backup alerts. Journald works without it.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_COOLDOWN_SECONDS=21600

# Admin control plane ---------------------------------------------------------------
# Disabled by default. Create at least one admin with server/adminCli.mjs before enabling.
ADMIN_PANEL_ENABLED=0
# Production HTTPS should keep Secure admin cookies. Set 0 only for an explicitly isolated local
# development/tunnel setup where the browser cannot use HTTPS.
ADMIN_COOKIE_SECURE=1
