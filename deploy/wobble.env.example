# Настройки сервера. Копировать в /etc/wobble.env и отредактировать.
#
# chmod 600 /etc/wobble.env — файл читает только root и systemd.

NODE_ENV=production

# Порт, на котором слушает Node. Наружу он не смотрит — снаружи стоит Nginx.
PORT=3000

# Слушать только локальный интерфейс.
#
# Без этого порт 3000 виден из интернета напрямую, в обход Nginx: без TLS, без заголовков
# безопасности и без ограничений по адресу. Игра при этом работает, поэтому ошибку легко
# не заметить.
HOST=127.0.0.1

# Разбирать X-Forwarded-For.
#
# За Nginx адрес соединения — это всегда 127.0.0.1, один на всех. Ограничения «24 сокета и
# 40 операций с комнатами в минуту с адреса» тогда делятся между ВСЕМИ игроками сразу, и отказы
# начинают сыпаться на случайных людей при нескольких десятках человек онлайн.
#
# Включать ТОЛЬКО когда Node недоступен из интернета напрямую (см. HOST выше): иначе заголовок
# подделает кто угодно и обойдёт лимиты.
TRUST_PROXY=1

# Кто может открывать WebSocket. Через запятую, со схемой, без слэша на конце.
# Если не задать — разрешены свой хост и localhost. Задать стоит: это защита от того, что игру
# встроят на чужой сайт и будут гонять ваш сервер оттуда.
ALLOWED_ORIGINS=https://example.com
