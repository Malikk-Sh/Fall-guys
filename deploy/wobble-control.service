[Unit]
Description=Wobble Rush resilient control plane
Documentation=https://github.com/Malikk-Sh/Fall-guys
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=wobble
Group=wobble
WorkingDirectory=/opt/wobble
ExecStart=/usr/bin/node server/controlPlane.js
EnvironmentFile=/etc/wobble.env
Environment=CONTROL_PORT=3001

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wobble-control

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The process reads the gameplay SQLite database and creates low-frequency admin session/audit writes.
# It must never write application code or arbitrary system paths.
ReadWritePaths=/var/lib/wobble
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
