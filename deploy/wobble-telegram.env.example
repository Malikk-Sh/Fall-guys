# Wobble Control -> Telegram delivery.
# Installer copies this file to /etc/wobble-telegram.env only when that file does not already exist.
# Keep /etc/wobble-telegram.env mode 0600 and never commit the real token.

# Disabled until BotFather token and numeric chat ID are configured.
TELEGRAM_ALERTS_ENABLED=0

# BotFather token. Do not paste the real value into Git/GitHub/issues/chat logs.
TELEGRAM_BOT_TOKEN=

# Numeric private/group/channel chat ID, for example 123456789 or -1001234567890.
TELEGRAM_CHAT_ID=

# critical (default) or warning.
TELEGRAM_ALERT_MIN_SEVERITY=critical
